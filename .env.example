# Copy to .env.local and fill in. .env.local is gitignored.

# Public — ships in the browser bundle. Safe to commit real values if the
# deployment reads them from elsewhere; RLS is what protects the data.
NEXT_PUBLIC_POSTBASE_URL=https://gateway.myklola.cloud
NEXT_PUBLIC_POSTBASE_PROJECT_ID=
NEXT_PUBLIC_POSTBASE_ANON_KEY=

# Server-side only — bypasses RLS. Never prefix with NEXT_PUBLIC_.
POSTBASE_SERVICE_KEY=