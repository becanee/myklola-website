# myKlola auth gateway — server-only.
# No NEXT_PUBLIC_ prefix: these are read only inside the /api/v1/login route
# handler at request time, so `next build` needs none of them. That is what
# keeps a Docker build from shipping a dead auth client.
GATEWAY_URL=https://gateway.myklola.cloud/api/auth/v1
PROJECT_ID=41e3b84f-643f-4eb1-b16f-6f82972f2b5d
GATEWAY_API_KEY=